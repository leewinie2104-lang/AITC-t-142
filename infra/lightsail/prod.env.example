# Template for /opt/parksmart/.env on the Lightsail host (ADR-0012). cloud-init copies it there with
# chmod 600 and a random POSTGRES_PASSWORD. Fill the rest in the Lightsail browser SSH session:
#   sudo nano /opt/parksmart/.env
# Never commit the filled file. DATABASE_URL / REDIS_URL / APP_ENV are set by docker-compose.prod.yml.

# ---- Caddy / HTTPS: static IP with dashes, e.g. 13-250-1-2.sslip.io ----
SITE_ADDRESS=

# ---- Postgres (generated by cloud-init; changing it later needs ALTER USER too) ----
POSTGRES_PASSWORD=

# ---- Start worker + agent-worker once arq is enabled in server/requirements.txt ----
# COMPOSE_PROFILES=workers

# ---- LLM (server/src/app/platform/llm/client.py) ----
# Any OpenAI-compatible provider; empty LLM_BASE_URL = api.openai.com
LLM_API_KEY=
# LLM_BASE_URL=
MODEL_CLASSIFY=gpt-4o-mini
MODEL_GENERATE=gpt-4o
MODEL_JUDGE=gpt-4o-mini
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=2048

# ---- App ----
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=
LOG_LEVEL=INFO

# ---- LangSmith (optional) ----
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=parksmart-ai-prod
LANGCHAIN_TRACING_V2=false
