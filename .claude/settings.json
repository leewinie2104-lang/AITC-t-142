{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make install)",
      "Bash(make test*)",
      "Bash(make lint*)",
      "Bash(make format*)",
      "Bash(make typecheck*)",
      "Bash(make eval*)",
      "Bash(make check*)",
      "Bash(make run*)",
      "Bash(pytest *)",
      "Bash(python -m pytest *)",
      "Bash(ruff *)",
      "Bash(mypy *)",
      "Bash(python3 eval/*)",
      "Bash(python eval/*)",
      "Bash(python3 scripts/check_docs.py*)",
      "Bash(python scripts/check_docs.py*)",
      "Bash(python3 .claude/hooks/check_arch.py*)",
      "Bash(python .claude/hooks/check_arch.py*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(docker compose ps*)",
      "Bash(docker compose logs*)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(git commit*)",
      "Bash(git reset*)",
      "Bash(pip install*)",
      "Bash(docker compose down*)",
      "Edit(.github/**)",
      "Edit(server/requirements.txt)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(**/*.pem)",
      "Read(**/*credential*)",
      "Read(.ai-log/**)",
      "Edit(.ai-log/**)",
      "Edit(docs/guide/**)",
      "Edit(scripts/log_hook.py)",
      "Edit(scripts/log_antigravity.py)",
      "Edit(scripts/submit_log.py)",
      "Bash(sudo *)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(*--no-verify*)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cmd /c scripts\\_pyrun.cmd scripts\\log_hook.py --tool=claude 2>nul || bash scripts/_pyrun.sh scripts/log_hook.py --tool=claude"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && bash scripts/_pyrun.sh .claude/hooks/session_context.py",
            "shell": "bash",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && bash scripts/_pyrun.sh .claude/hooks/guard_bash.py",
            "shell": "bash",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && bash scripts/_pyrun.sh .claude/hooks/format_python.py",
            "shell": "bash",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && bash scripts/_pyrun.sh .claude/hooks/check_arch.py",
            "shell": "bash",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
