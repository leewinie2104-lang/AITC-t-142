# ============================================
# ParkSmart AI — Environment Variables (file .env đặt ở gốc repo)
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM (router theo task — server/src/app/platform/llm/client.py) ----
# Dev: Groq qua API tương thích OpenAI (ADR-0013). Key tạo ở https://console.groq.com/keys (bắt đầu bằng gsk_).
# Để trống LLM_BASE_URL = api.openai.com. Tên cũ OPENAI_API_KEY / OPENAI_BASE_URL vẫn được đọc.
LLM_API_KEY=gsk_your-groq-key-here
LLM_BASE_URL=https://api.groq.com/openai/v1
# Model theo task. Kiểm tra tên và rate limit gói free ở https://console.groq.com/docs/models
MODEL_CLASSIFY=llama-3.1-8b-instant
MODEL_GENERATE=llama-3.3-70b-versatile
# Judge PHẢI khác MODEL_GENERATE (chống self-preference bias; app raise nếu trùng). Khác họ model càng tốt.
MODEL_JUDGE=openai/gpt-oss-120b
LLM_TEMPERATURE=0.7

# ---- Database ----
# Khớp service postgres trong docker-compose.yml (ADR-0005; pgvector cho RAG)
DATABASE_URL=postgresql://parksmart:parksmart@localhost:5432/parksmart

# ---- Redis (hàng đợi arq, pub/sub — ADR-0004) ----
REDIS_URL=redis://localhost:6379/0

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=parksmart-ai
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=<get-your-api-key-from-dashboard-phoenix>
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
