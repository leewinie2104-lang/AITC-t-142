# ============================================
# ParkSmart AI — biến môi trường cho DEV (file .env đặt ở gốc repo)
# ============================================
# Tạo .env: `make .env` (không ghi đè .env có sẵn) hoặc `cp .env.example .env`, rồi THAY NGUYÊN CHỮ các chỗ
# viết hoa kết thúc bằng _HERE (ví dụ APP_PASSWORD_HERE) bằng giá trị thật: không thêm dấu < >, nháy hay khoảng trắng.
# KHÔNG commit .env. Secret thật lấy qua Bitwarden của team, không gửi qua git / Jira / chat.
#
# 4 mật khẩu của DB / Redis dev (sinh trên EC2 trong /opt/parksmart-devdb/.env, lưu ở Bitwarden):
#   APP_PASSWORD       → dùng trong DATABASE_URL (dev cần)
#   REDIS_PASSWORD     → dùng trong REDIS_URL (dev cần)
#   MIGRATOR_PASSWORD  → chỉ CI dùng, KHÔNG đặt ở đây
#   POSTGRES_PASSWORD  → superuser, chỉ để cứu hộ, KHÔNG đặt ở đây
# Mỗi mật khẩu dài đúng 48 ký tự 0-9a-f.
#
# Môi trường dev (plan 017):
#   - Postgres + Redis dùng chung chạy trên EC2 `parksmart-ci-runner` (cùng máy CI), vào qua Tailscale.
#     Máy bật 08:00–22:00 (giờ VN); ngoài giờ DB / Redis không truy cập được.
#   - LLM: Groq (API tương thích OpenAI). Unit test và CI không gọi LLM thật.
#   - API / worker chạy trên máy bạn: `make run`.
# docker-compose.yml chỉ là mẫu cho demo/prod; nếu chạy nó, compose tự ghi đè DATABASE_URL / REDIS_URL
# sang container local.

# ---- LLM: Groq (server/src/app/platform/llm/client.py) ----
# Key tạo ở https://console.groq.com/keys (bắt đầu bằng gsk_). Gọi qua API tương thích OpenAI, nên đổi
# nhà cung cấp chỉ cần đổi LLM_BASE_URL + key (để trống LLM_BASE_URL = api.openai.com).
# Tên cũ OPENAI_API_KEY / OPENAI_BASE_URL vẫn được đọc nếu file của bạn còn dùng.
LLM_API_KEY=gsk_your-groq-key-here
LLM_BASE_URL=https://api.groq.com/openai/v1
# Model theo task. Kiểm tra tên và rate limit gói free ở https://console.groq.com/docs/models
# Danh sách model key của bạn dùng được (Groq đổi model thường xuyên), chạy trong server/:
#   PYTHONPATH=src ../.venv/bin/python -c "from openai import OpenAI; from app.platform.config.settings import get_settings as g; s=g(); [print(m.id) for m in OpenAI(api_key=s.llm_api_key, base_url=s.llm_base_url).models.list().data]"
MODEL_CLASSIFY=openai/gpt-oss-20b
MODEL_GENERATE=openai/gpt-oss-120b
# Judge PHẢI khác MODEL_GENERATE (chống self-preference bias; app raise nếu trùng). Khác họ model càng tốt.
MODEL_JUDGE=qwen/qwen3.8-27b
LLM_TEMPERATURE=0.7

# ---- Database: Postgres 16 + pgvector trên EC2 dev (ADR-0005, plan 017) ----
# User `parksmart_app`: không phải owner, không BYPASSRLS, nên RLS theo khu / hộ có hiệu lực.
# Host là tên máy trong Tailscale (bật Tailscale trên máy bạn trước). Cổng 15432, không phải 5432.
# Migration chỉ do CI chạy sau khi merge `dev` (role parksmart_migrator). KHÔNG chạy `alembic` bằng tay lên DB này.
# Thay APP_PASSWORD_HERE bằng APP_PASSWORD. Đúng: ...parksmart_app:3f9a…(48 ký tự)…@parksmart-ci-runner...
DATABASE_URL=postgresql://parksmart_app:APP_PASSWORD_HERE@parksmart-ci-runner:15432/parksmart

# ---- Migration (Alembic, server/migrations/env.py) ----
# Chỉ dùng khi thử migration MỚI trên Postgres local (`docker compose up -d postgres`), rồi trong server/:
#   alembic upgrade head && alembic downgrade -1 && alembic upgrade head
# Để trống thì Alembic dùng DATABASE_URL ở trên (role parksmart_app), và sẽ bị từ chối vì app không có quyền DDL.
# DB dùng chung chỉ do CI migrate (URL role migrator nằm trong env của runner trên EC2, không đặt trong .env).
# MIGRATE_DATABASE_URL=postgresql://parksmart:parksmart@localhost:5432/parksmart

# ---- Redis: arq queue + pub/sub trên EC2 dev (ADR-0004) ----
# Thay REDIS_PASSWORD_HERE bằng REDIS_PASSWORD (giữ dấu ':' đứng trước, Redis không có username).
# Số cuối là DB index của bạn (0–15, chia trong team) để worker máy này không nhận job của máy khác.
REDIS_URL=redis://:REDIS_PASSWORD_HERE@parksmart-ci-runner:16379/0

# ---- App ----
# development | production | test (CI đặt test). Cổng API cố định 8000 trong `make run`.
APP_ENV=development

# ---- LangSmith: trace LLM / Agent (gói free) ----
# Mỗi dev một project để trace không lẫn nhau, ví dụ parksmart-dev-phuc.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=LANGSMITH_API_KEY_HERE
LANGSMITH_PROJECT=parksmart-dev-YOUR_NAME_HERE

# ---- AI hook logging (BTC cung cấp, được chấm điểm) ----
# Mỗi thành viên tự lấy key trên dashboard Phoenix; để placeholder thì log không vào hệ thống chấm.
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=<get-your-api-key-from-dashboard-phoenix>
AI_LOG_DIR=.ai-log
